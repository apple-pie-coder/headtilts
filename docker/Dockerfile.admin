# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
WORKDIR /app

# pnpm's native @pnpm/exe binary (pinned via packageManager) needs libatomic
RUN apt-get update -y && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/admin/package.json      ./apps/admin/

RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# VITE_API_URL is baked into the JS bundle at build time.
# When nginx proxies /api/ → the API container, the browser-relative
# path "/api" works regardless of the host domain or HTTP_PORT.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

COPY packages/shared ./packages/shared
COPY apps/admin      ./apps/admin

RUN pnpm --filter @headtilts/shared build
RUN pnpm --filter @headtilts/admin  build

# ── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:stable-alpine AS production

# Minimal nginx config: serve the SPA, gzip assets, long-lived cache headers
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    gzip on;\n\
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        try_files $uri =404;\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html

EXPOSE 80
