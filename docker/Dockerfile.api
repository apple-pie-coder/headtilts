# ── Stage 1: Dependencies ─────────────────────────────────────────────────────
# Installed once and shared by the build and production stages, so a code-only
# change never reinstalls packages and a dependency change installs them once.
FROM node:22-slim AS deps
WORKDIR /app

# pnpm's native @pnpm/exe binary (pinned via packageManager) needs libatomic.
# OpenSSL lets Prisma's postinstall pick the same engine production uses, so
# the runtime `prisma generate` finds it locally instead of downloading it.
RUN apt-get update -y && apt-get install -y --no-install-recommends libatomic1 openssl && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

# Copy manifests first — this layer is re-used unless a dependency changes
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json           ./apps/api/

# All dependencies (prod + dev): the prisma CLI lives in devDependencies and is
# needed at runtime to run `prisma migrate deploy` on startup.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ── Stage 2: Build ────────────────────────────────────────────────────────────
FROM deps AS builder

# Copy source and compile
COPY packages/shared ./packages/shared
COPY apps/api        ./apps/api

# Re-generate the Prisma client now that the schema is present.
# pnpm install runs prisma generate as a postinstall hook, but at that point
# the schema hasn't been copied yet, so it generates an empty client.
# Running it again here produces the correct model-aware types for tsc.
RUN cd apps/api && npx prisma generate

RUN pnpm --filter @headtilts/shared build
RUN pnpm --filter @headtilts/api    build

# ── Stage 3: Production ───────────────────────────────────────────────────────
FROM node:22-slim AS production
WORKDIR /app

# Prisma needs OpenSSL; backup/restore needs mysqldump and mysql clients.
# Fonts: sharp draws text in generated images (link previews, poll results) with
# the system's fonts; without any, every glyph renders as a box.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl default-mysql-client fontconfig fonts-inter fonts-dejavu-core && rm -rf /var/lib/apt/lists/*

# Reuse the installed dependencies instead of installing them a second time.
# Copied from `deps` (not `builder`) so this layer only changes with dependencies.
COPY package.json pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json           ./apps/api/
COPY --from=deps /app/node_modules          ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules

# Copy compiled output from the build stage
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/dist        ./apps/api/dist
COPY apps/api/prisma                          ./apps/api/prisma

# Generate the Prisma client for the production runtime
RUN cd apps/api && npx prisma generate

# Create the uploads directory; docker-compose mounts a named volume here
RUN mkdir -p /app/apps/api/uploads

EXPOSE 3000

# Run pending migrations then start. DATABASE_URL is injected at runtime
# by docker-compose, so migrations cannot run during the build stage.
CMD ["sh", "-c", "cd apps/api && npx prisma migrate deploy && node dist/index.js"]
