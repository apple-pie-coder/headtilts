# ─────────────────────────────────────────────────────────────────────────────
# Headtilts CMS — PRODUCTION environment template
#
# Copy to .env on your production server:
#   cp .env.prod .env
#   nano .env    # replace every CHANGE_ME value with real credentials
#
# Security checklist before going live:
#   [ ] JWT_SECRET and JWT_REFRESH_SECRET are unique 64+ character random strings
#   [ ] Database password is strong and not shared with staging/dev
#   [ ] SITE_URL, WEB_URL, ADMIN_URL match your live domain exactly
#   [ ] SMTP credentials are set (or email is consciously disabled)
#   [ ] .env file has permissions 600: chmod 600 .env
#
# IMPORTANT: This file is safe to commit (it contains no real secrets).
#            The working .env file is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Host is "mysql" inside Docker Compose's internal network.
DATABASE_URL=mysql://CHANGE_ME_USER:CHANGE_ME_PASS@mysql:3306/CHANGE_ME_DB
MYSQL_DATABASE=headtilts
MYSQL_USER=CHANGE_ME_MYSQL_USER
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# ── JWT secrets ───────────────────────────────────────────────────────────────
# MUST be long random strings — different from staging and dev.
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3000

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Must match the exact URL users access (protocol + domain, no trailing slash).
SITE_URL=https://CHANGE_ME.com
WEB_URL=https://CHANGE_ME.com
ADMIN_URL=https://CHANGE_ME.com/admin

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/apps/api/uploads
MAX_UPLOAD_SIZE=10mb

# ── Docker — nginx port ───────────────────────────────────────────────────────
# If a load balancer or Cloudflare sits in front, keep at 80 here.
# Cloudflare / nginx on the host handles HTTPS; this is the internal HTTP port.
HTTP_PORT=80

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
VITE_API_URL=/api

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Required in production for password reset and notification emails.
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=Headtilts <no-reply@CHANGE_ME.com>
