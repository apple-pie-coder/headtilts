# ─────────────────────────────────────────────────────────────────────────────
# CMS — Docker environment template
# Copy this file to .env, then fill in every value before running:
#   cp .env.docker .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Port ─────────────────────────────────────────────────────────────────────
# The single port the entire app listens on. Change this to anything you like
# (e.g. 8080, 9000). nginx binds to this port on the host.
HTTP_PORT=80

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Use strong, unique passwords. These are only used inside Docker's internal
# network — MySQL is never exposed to the host.
MYSQL_ROOT_PASSWORD=your-strong-root-password
MYSQL_DATABASE=your-database-name
MYSQL_USER=database-user
MYSQL_PASSWORD=your-strong-database-password

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Both must be long random strings. Changing them invalidates all active sessions.
JWT_SECRET=strong-random-string-for-jwt-secret
JWT_REFRESH_SECRET=strong-random-string-for-jwt-refresh-secret

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Set these to your server's domain (or IP). If HTTP_PORT is not 80, include
# the port here too, e.g. http://myserver.com:8080
SITE_URL=http://localhost
WEB_URL=http://localhost
ADMIN_URL=http://localhost/admin

# ── Vite build-time API URL ───────────────────────────────────────────────────
# The path that the browser uses to reach the API. Because nginx proxies
# /api/ to the API container, a relative path works for any domain or port.
# Only change this if you are hosting the API on a completely separate domain.
VITE_API_URL=/api

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email. Contact form submissions and comment
# notifications will be logged to the API console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Razorpay (optional) ───────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=rzp_test_CHANGE_ME
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME