# ─────────────────────────────────────────────────────────────────────────────
# Headtilts CMS — STAGING environment template
#
# Copy to .env on your staging server:
#   cp .env.staging .env
#   nano .env    # replace every CHANGE_ME value
#
# IMPORTANT: This file is safe to commit (it contains no real secrets).
#            The working .env file is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=staging

# ── Database ─────────────────────────────────────────────────────────────────
# Inside Docker Compose the host is always "mysql".
# Replace credentials with your staging values.
DATABASE_URL=mysql://CHANGE_ME_USER:CHANGE_ME_PASS@mysql:3306/headtilts_staging
MYSQL_DATABASE=headtilts_staging
MYSQL_USER=CHANGE_ME_MYSQL_USER
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3000

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Replace with your staging domain or IP.
# If using a non-standard port include it: http://staging.example.com:8080
SITE_URL=https://staging.CHANGE_ME.com
WEB_URL=https://staging.CHANGE_ME.com
ADMIN_URL=https://staging.CHANGE_ME.com/admin

# ── File uploads ─────────────────────────────────────────────────────────────
# Absolute path inside the container (mapped to a Docker volume).
UPLOAD_DIR=/app/apps/api/uploads
MAX_UPLOAD_SIZE=10mb

# ── Docker — nginx port ───────────────────────────────────────────────────────
# Staging typically runs behind a reverse proxy; keep at 80 unless you have a
# reason to change it.
HTTP_PORT=80

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# nginx proxies /api/ to the API container — leave as relative path.
VITE_API_URL=/api

# ── SMTP (optional) ───────────────────────────────────────────────────────────
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=Headtilts Staging <no-reply@staging.CHANGE_ME.com>

# ── Razorpay (optional) ───────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=rzp_test_CHANGE_ME
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME