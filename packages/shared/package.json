{
  "name": "@headtilts/shared",
  "version": "1.0.0",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc --outDir dist/cjs && tsc -m es2020 --outDir dist/esm",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
