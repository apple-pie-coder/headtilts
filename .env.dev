# ─────────────────────────────────────────────────────────────────────────────
# Headtilts CMS — DEVELOPMENT environment template
#
# Copy to .env before starting the app:
#   cp .env.dev .env
#   # Then fill in any placeholder values (marked CHANGE_ME)
#
# These defaults target a locally-running stack (native pnpm dev or Docker on
# localhost:8080).  For a Docker-based dev session, set HTTP_PORT=8080 and
# run `docker compose up -d --build`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Local MySQL (native dev).  Change to mysql://headtilts:headtilts@mysql:3306/headtilts
# when running inside Docker Compose.
DATABASE_URL=mysql://headtilts:headtilts@localhost:3306/headtilts
MYSQL_DATABASE=headtilts
MYSQL_USER=headtilts
MYSQL_ROOT_PASSWORD=root-password-dev
MYSQL_PASSWORD=headtilts-password-dev

# ── JWT secrets ───────────────────────────────────────────────────────────────
# These dev secrets are intentionally weak — NEVER use them outside dev.
# Generate strong secrets for other environments:
#   openssl rand -base64 64
JWT_SECRET=dev-jwt-secret-not-for-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-not-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3000

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Native pnpm dev (web on :5173, admin on :5174 proxied via :5173/admin/)
SITE_URL=http://localhost:5173
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Uncomment for Docker-based dev (nginx on :8080)
# SITE_URL=http://localhost:8080
# WEB_URL=http://localhost:8080
# ADMIN_URL=http://localhost:8080/admin

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10mb

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# Native dev — browser talks directly to the API on :3000
VITE_API_URL=http://localhost:3000/api

# Uncomment for Docker-based dev — nginx proxies /api/ internally
# VITE_API_URL=/api

# ── Docker ───────────────────────────────────────────────────────────────────
# Only used when running `docker compose up`
# HTTP_PORT=8080

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email (requests are logged to console).
# For local testing use MailHog (included in docker-compose.yml):
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_HOST=
# SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Headtilts Dev <no-reply@localhost>

# ── Razorpay (optional) ───────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=rzp_test_CHANGE_ME
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME