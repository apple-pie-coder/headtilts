datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===================== Users & Authentication =====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String
  firstName     String?
  lastName      String?
  avatar        String?
  bio           String?  @db.Text
  website       String?
  location      String?
  twitterUrl    String?
  linkedinUrl   String?
  githubUrl     String?
  instagramUrl  String?
  isActive      Boolean  @default(true)
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  mfaBackupCodes String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts         Post[]
  coAuthoredPosts PostCoAuthor[]
  media         Media[]
  userRoles     UserRole[]
  sessions      Session[]
  notifications               Notification[]
  notificationPreferences     UserNotificationPreference[]
  revisions                   PostRevision[]
  pollVotes                   PollVote[]
  apiKeys                     ApiKey[]

  @@index([email])
  @@index([username])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // see NotificationType enum in notifications.service.ts
  title     String
  body      String?   @db.Text
  link      String?   // admin route to open, e.g. '/admin/comments'
  data      Json?     // optional structured payload (entity ids, etc.)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserNotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // notification type key
  channel   String   @default("inapp")  // 'email' | 'inapp' | 'both' | 'none'
  enabled   Boolean  @default(true)
  threshold Int?     // for threshold-based notifications (e.g. failed login count)
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ===================== Roles & Permissions =====================

model Role {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?       @db.Text
  isSystem    Boolean       @default(false)
  mfaRequired Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  permissions       RolePermission[]
  userRoles         UserRole[]

  @@index([name])
}

model Permission {
  id          Int           @id @default(autoincrement())
  module      String
  action      String
  description String?       @db.Text
  createdAt   DateTime      @default(now())

  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId String
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ===================== Posts & Publishing =====================

model Post {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    @db.LongText
  excerpt         String?   @db.Text
  type            String    @default("post")
  parentId        Int?
  parent          Post?     @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Post[]    @relation("PageHierarchy")
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status          String    @default("draft")
  publishedAt     DateTime?
  scheduledFor    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  featuredImage   String?
  template        String?
  isFeatured      Boolean   @default(false)
  showSidebar     Boolean   @default(false)
  commentStatus   String?   // null = inherit site default, "open" / "closed" = per-post override
  showToc         String?   // null = inherit site default, "yes" / "no" = per-post override

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?

  categories      PostCategory[]
  tags            PostTag[]
  coAuthors       PostCoAuthor[]
  seoMetadata     SeoMetadata?
  comments        Comment[]
  revisions       PostRevision[]
  polls           Poll[]
  reactions       PostReaction[]
  seriesPosts     SeriesPost[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([parentId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([scheduledFor])
  @@index([isFeatured])
}

// ===================== Post Revisions =====================

model PostRevision {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // 'created' | 'updated' | 'published' | 'unpublished' | 'scheduled' | 'trashed'
  changes    Json?    // ChangeEntry[] — { field, label, from?, to?, note? }
  snapshot   Json?    // full restorable post fields at save time
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
  @@index([postId, isArchived])
}

// ===================== Media Library =====================

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  url          String              // delivery version (capped + optionally webp/avif)
  originalUrl  String?             // untouched source upload
  mimeType     String
  size         Int
  width        Int?                // intrinsic pixel width (images only)
  height       Int?                // intrinsic pixel height (images only)
  altText      String?
  title        String?
  caption      String?  @db.Text
  description  String?  @db.Text
  contentHash  String?             // sha256 of source bytes, for dedup
  thumbnailUrl String?
  mediumUrl    String?
  folderId     Int?
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([mimeType])
  @@index([uploadedById])
  @@index([contentHash])
  @@index([folderId])
}

model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  media     Media[]

  @@index([slug])
}

model Comment {
  id          Int       @id @default(autoincrement())
  postId      Int
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentThread")
  authorName  String
  authorEmail String
  content     String    @db.Text
  status      String    @default("pending")
  visitorId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reactions   CommentReaction[]

  @@index([postId, status])
  @@index([status])
  @@index([parentId])
  @@index([authorEmail])
}

model CommentReaction {
  id        Int      @id @default(autoincrement())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  emoji     String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([commentId, emoji, visitorId])
  @@index([commentId])
}

model ContactSubmission {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String    @db.Text
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  parentId    Int?
  icon        String?
  showSidebar Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  posts       PostCategory[]

  @@index([slug])
  @@index([parentId])
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  postId     Int
  categoryId Int
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts       PostTag[]

  @@index([slug])
}

model PostTag {
  id     Int  @id @default(autoincrement())
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model PostCoAuthor {
  id     Int    @id @default(autoincrement())
  postId Int
  userId String
  order  Int    @default(0)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ===================== Menus & Navigation =====================

model Menu {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  location    String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       MenuItem[]

  @@index([location])
}

model MenuItem {
  id          Int       @id @default(autoincrement())
  menuId      Int
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId    Int?
  title       String
  url         String?
  postId      Int?
  categoryId  Int?
  tagId       Int?
  position    Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      MenuItem? @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    MenuItem[] @relation("MenuItemHierarchy")

  @@index([menuId])
  @@index([parentId])
}

// ===================== Widgets & Widget Zones =====================

model Widget {
  id          Int       @id @default(autoincrement())
  name        String
  type        String
  title       String?
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  settings    WidgetSetting[]
  zones       WidgetZoneWidget[]

  @@unique([name])
  @@index([type])
}

model WidgetZone {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  maxWidgets  Int       @default(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  widgets     WidgetZoneWidget[]

  @@index([name])
}

model WidgetZoneWidget {
  id       Int    @id @default(autoincrement())
  zoneId   Int
  widgetId Int
  zone     WidgetZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  widget   Widget     @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@unique([zoneId, widgetId])
  @@index([zoneId])
  @@index([widgetId])
}

model WidgetSetting {
  id       Int    @id @default(autoincrement())
  widgetId Int
  widget   Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  key      String
  value    String @db.LongText
  type     String

  @@unique([widgetId, key])
  @@index([widgetId])
}

// ===================== Settings =====================

model Setting {
  id      Int     @id @default(autoincrement())
  key     String  @unique
  value   String  @db.LongText
  type    String

  @@index([key])
}

// ===================== SEO =====================

model SeoMetadata {
  id              Int     @id @default(autoincrement())
  postId          Int     @unique
  post            Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  focusKeyword    String?
  readabilityScore Int?
  seoScore        Int?

  @@index([postId])
}

model Sitemap {
  id        Int     @id @default(autoincrement())
  url       String  @unique
  priority  Float   @default(0.5)
  changefreq String?
  lastmod   DateTime?

  @@index([url])
}

// ===================== Celebrations =====================

// Artist birthdays & remembrances. Recurs annually, so the date is stored as
// month/day; `year` (optional) is the birth year or year of passing.
model Celebration {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // 'birthday' | 'remembrance'
  month     Int      // 1-12
  day       Int      // 1-31
  year      Int?
  photo     String?  @db.Text
  message   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month, day])
}

// ===================== Polls =====================

model Poll {
  id                Int                  @id @default(autoincrement())
  title             String
  question          String               @db.Text
  slug              String               @unique
  description       String?              @db.Text
  status            String               @default("draft")
  voteMode          String               @default("single")
  resultVisibility  String               @default("after_vote")
  voterRestriction  String               @default("anonymous")
  allowVoteChange   Boolean              @default(false)
  showSidebar       Boolean              @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  featuredImage     String?
  postId            Int?
  post              Post?                @relation(fields: [postId], references: [id], onDelete: SetNull)
  options           PollOption[]
  votes             PollVote[]
  shares            PollShare[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([slug])
  @@index([status])
  @@index([postId])
}

model PollShare {
  id                Int              @id @default(autoincrement())
  pollId            Int
  poll              Poll             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  token             String           @unique
  sharerIdentifier  String?
  recipientEmail    String?
  recipientName     String?
  note              String?          @db.Text
  channel           String           @default("link")
  clicks            Int              @default(0)
  firstClickAt      DateTime?
  lastClickAt       DateTime?
  createdAt         DateTime         @default(now())
  clickDetails      PollShareClick[]

  @@index([pollId])
  @@index([token])
  @@index([sharerIdentifier])
}

model PollShareClick {
  id        Int       @id @default(autoincrement())
  shareId   Int
  share     PollShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  name      String?
  gender    String?
  age       Int?
  clickedAt DateTime  @default(now())

  @@index([shareId])
}

model PollOption {
  id        Int        @id @default(autoincrement())
  pollId    Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  order     Int        @default(0)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id              Int        @id @default(autoincrement())
  pollId          Int
  poll            Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId        Int
  option          PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterIdentifier String
  ipAddress       String?
  userId          String?
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([pollId, optionId, voterIdentifier])
  @@index([pollId])
  @@index([voterIdentifier])
}

// ===================== Post Reactions =====================

model PostReaction {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  emoji     String   // e.g. "❤️", "👏", "🔥", "😮"
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, emoji, visitorId])
  @@index([postId])
}

// ===================== Series / Collections =====================

model Series {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?      @db.Text
  coverImage  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  posts       SeriesPost[]

  @@index([slug])
}

model SeriesPost {
  id       Int    @id @default(autoincrement())
  seriesId Int
  postId   Int
  position Int    @default(0)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([seriesId, postId])
  @@index([seriesId])
  @@index([postId])
}

// ===================== Redirects =====================

model Redirect {
  id        Int      @id @default(autoincrement())
  fromPath  String   @unique
  toPath    String
  type      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromPath])
}

// ===================== API Keys =====================

model ApiKey {
  id          Int              @id @default(autoincrement())
  name        String
  prefix      String           @unique
  keyHash     String           @unique
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes      String           @db.Text
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  usageLogs   ApiKeyUsageLog[]

  @@index([userId])
  @@index([keyHash])
}

model ApiKeyUsageLog {
  id         Int      @id @default(autoincrement())
  apiKeyId   Int
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  method     String   // GET, POST, PUT, DELETE, etc.
  endpoint   String   // normalised path, e.g. /posts/:id
  statusCode Int
  durationMs Int      // response time in milliseconds
  ip         String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@index([endpoint, createdAt])
}

// ===================== Backups =====================

model Backup {
  id          Int       @id @default(autoincrement())
  filename    String    @unique
  label       String?
  sizeBytes   BigInt    @default(0)
  status      String    @default("pending") // pending | ready | failed
  errorMsg    String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// ===================== Activity Logs =====================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now()) @db.DateTime(6)
  site        String   @db.VarChar(20)
  level       String   @db.VarChar(10)
  category    String   @db.VarChar(40)
  action      String   @db.VarChar(80)
  actorId     String?  @db.VarChar(36)
  actorEmail  String?  @db.VarChar(255)
  targetType  String?  @db.VarChar(40)
  targetId    String?  @db.VarChar(40)
  targetTitle String?  @db.VarChar(255)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  path        String?  @db.VarChar(500)
  method      String?  @db.VarChar(10)
  statusCode  Int?
  duration    Int?
  meta        Json?

  @@index([timestamp])
  @@index([site, timestamp])
  @@index([level, timestamp])
  @@index([category, timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
}

// ===================== Events =====================

model Event {
  id                     Int       @id @default(autoincrement())
  title                  String
  slug                   String    @unique
  excerpt                String?   @db.Text
  description            String?   @db.LongText
  startAt                DateTime
  endAt                  DateTime
  timezone               String    @default("UTC")
  type                   String    @default("in_person") // in_person | online | hybrid
  status                 String    @default("draft") // draft | published | cancelled | postponed
  featuredImage          String?
  bannerImage            String?
  venueName              String?
  venueAddress           String?
  venueCity              String?
  venueState             String?
  venueCountry           String?
  venueMapEmbed          String?   @db.Text
  onlineUrl              String?
  streamUrl              String?
  streamPlatform         String?   // youtube | twitch | custom
  maxAttendees           Int?
  isRegistrationRequired Boolean   @default(true)
  registrationDeadline   DateTime?
  requireApproval        Boolean   @default(false)
  showAttendeesCount     Boolean   @default(true)
  showAttendeesNames     Boolean   @default(false)
  isFeatured             Boolean   @default(false)
  isRecurring            Boolean   @default(false)
  recurrenceType         String?   // daily | weekly | monthly | yearly
  recurrenceInterval     Int?
  recurrenceDays         String?   // JSON array e.g. "[1,3,5]"
  recurrenceEndsAt       DateTime?
  parentEventId          Int?
  metaTitle              String?
  metaDescription        String?   @db.Text
  ogImage                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  ticketTiers   EventTicketTier[]
  registrations EventRegistration[]
  speakers      EventSpeaker[]
  agendaItems   EventAgendaItem[]
  customFields  EventCustomField[]
  parentEvent   Event?  @relation("RecurringEventChildren", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents   Event[] @relation("RecurringEventChildren")

  @@index([status])
  @@index([startAt])
  @@index([slug])
  @@index([parentEventId])
}

model EventTicketTier {
  id             Int       @id @default(autoincrement())
  eventId        Int
  name           String
  description    String?   @db.Text
  price          Int       @default(0)
  currency       String    @default("INR")
  quantity       Int?
  soldCount      Int       @default(0)
  availableFrom  DateTime?
  availableUntil DateTime?
  isVisible      Boolean   @default(true)
  perOrderMin    Int       @default(1)
  perOrderMax    Int       @default(10)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([eventId])
}

model EventRegistration {
  id              Int       @id @default(autoincrement())
  eventId         Int
  ticketTierId    Int?
  name            String
  email           String
  phone           String?
  quantity        Int       @default(1)
  status          String    @default("pending") // pending | confirmed | waitlisted | cancelled
  ticketCode      String    @unique @default(uuid())
  paymentStatus   String    @default("free") // free | pending | paid | refunded
  paymentProvider String?
  paymentId       String?
  paymentOrderId  String?
  paymentAmount   Int?
  customData      Json?
  checkInAt       DateTime?
  registeredAt    DateTime  @default(now())
  cancelledAt     DateTime?

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier EventTicketTier? @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([email])
  @@index([ticketCode])
  @@index([status])
}

model EventSpeaker {
  id          Int     @id @default(autoincrement())
  eventId     Int
  name        String
  bio         String? @db.Text
  photo       String?
  designation String?
  company     String?
  socialLinks Json?
  position    Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventAgendaItem {
  id          Int      @id @default(autoincrement())
  eventId     Int
  title       String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime
  type        String   @default("session") // session | break | keynote | networking
  speakerId   Int?
  position    Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventCustomField {
  id        Int     @id @default(autoincrement())
  eventId   Int
  label     String
  fieldType String  @default("text") // text | textarea | select | checkbox
  options   Json?
  required  Boolean @default(false)
  position  Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
