# ─────────────────────────────────────────────────────────────────────────────
# Headtilts CMS — environment variables reference
#
# This file documents every variable the application uses.
# Do NOT copy this file directly — use the environment-specific templates:
#
#   .env.dev      → local development (sensible defaults already filled in)
#   .env.staging  → staging server (replace CHANGE_ME values)
#   .env.prod     → production server (replace CHANGE_ME values)
#
# Quick start:
#   cp .env.dev .env      # then adjust any values you need
#
# Or use the helper script:
#   ./scripts/switch-env.sh dev      # copies .env.dev → .env
#   ./scripts/switch-env.sh staging  # copies .env.staging → .env
#   ./scripts/switch-env.sh prod     # copies .env.prod → .env
#
# Full documentation: docs/environment-setup.html
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Controls Express error verbosity, Prisma query logging, etc.
# Values: development | staging | production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Prisma connection string.  In Docker Compose the host is always "mysql".
# In native dev use "localhost".
DATABASE_URL=mysql://user:pass@localhost:3306/headtilts

# MySQL service credentials — consumed by the mysql Docker container.
# Must match the credentials in DATABASE_URL.
MYSQL_DATABASE=headtilts
MYSQL_USER=headtilts
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_PASSWORD=your-db-password

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Long random strings — changing them invalidates all active sessions.
# Generate: openssl rand -base64 64
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API server ────────────────────────────────────────────────────────────────
# Internal Express port (not exposed to the host in Docker; nginx proxies to it).
API_PORT=3000

# ── Site URLs ─────────────────────────────────────────────────────────────────
# No trailing slashes.  Used in email templates, CORS, and redirects.
SITE_URL=http://localhost:5173
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
# Passkeys are tied to ADMIN_URL's hostname and need HTTPS (or localhost):
# browsers hide them on plain-HTTP addresses such as a LAN IP. Override only
# when the admin is reached through another hostname.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGINS=https://example.com,https://www.example.com

# ── File uploads ─────────────────────────────────────────────────────────────
# Relative to the api package root in native dev; absolute in Docker.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10mb

# ── Docker — nginx port ───────────────────────────────────────────────────────
# The single host-bound port that nginx listens on (e.g. 80, 8080, 443).
HTTP_PORT=8080

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# The URL the browser uses to reach the API.
# Native dev:  http://localhost:3000/api   (absolute — talks directly to API)
# Docker/prod: /api                        (relative — nginx proxies it)
VITE_API_URL=http://localhost:3000/api

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email (all sends are logged to console instead).
# Required for: password reset, notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Headtilts <no-reply@example.com>

# ── Telegram channel (optional) ───────────────────────────────────────────────
# Announces new posts, events and polls in a Telegram channel. Create a bot with
# @BotFather, add it to the channel as an admin (post, edit and delete messages),
# then turn it on in Settings → Telegram. These only fill the settings on first
# start; the Settings page wins after that. Buttons link to SITE_URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Razorpay (optional) ───────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=rzp_test_CHANGE_ME
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
# Razorpay dashboard → Webhooks: URL <SITE_URL>/api/public/payments/razorpay/webhook,
# events payment.authorized, payment.captured, refund.* and payment.dispute.*, and
# this secret. Refunds made in the dashboard then cancel the ticket automatically.
RAZORPAY_WEBHOOK_SECRET=

# ── Bot check on the ticket form (optional) ───────────────────────────────────
# Cloudflare Turnstile (free): dash.cloudflare.com → Turnstile → add your site's domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin feedback button → GitHub issues (optional).
# Create a fine-grained personal access token limited to this repository with
# "Issues: Read and write" permission. Without it, feedback stays in the admin.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=apple-pie-coder/headtilts
